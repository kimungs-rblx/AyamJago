    local normalBgColor = Color3.fromRGB(20, 20, 20)
    local minimizedBgColor = Color3.fromRGB(75, 75, 75)

    local function setMinimized(state)
        minimized = state
        if minimized then
            MainFrame.Draggable = false
            MainFrame.Size = minimizedSize
            MainFrame.BackgroundColor3 = minimizedBgColor
            mainCorner.CornerRadius = UDim.new(0, 6) 
            minimizedStroke.Enabled = true
            CreditLabel.Visible = false
            CloseBtn.Visible = false
            MinBtn.Visible = false
            for _, child in pairs(MainFrame:GetChildren()) do
                if child:IsA("ScrollingFrame") then
                    child.Visible = false
                end
            end
            MinimizedContent.Visible = true
        else
            MainFrame.Draggable = true
            MainFrame.Size = normalSize
            MainFrame.BackgroundColor3 = normalBgColor
            mainCorner.CornerRadius = UDim.new(0, 8)
            minimizedStroke.Enabled = false
            CreditLabel.Visible = true
            CloseBtn.Visible = true
            MinBtn.Visible = true
            for _, child in pairs(MainFrame:GetChildren()) do
                if child:IsA("ScrollingFrame") then
                    child.Visible = true
                end
            end
            MinimizedContent.Visible = false
        end
    end

    MinBtn.MouseButton1Click:Connect(function()
        setMinimized(true)
    end)

    -- Custom Drag & Click Handler untuk Minimized State
    local draggingMin = false
    local dragInputMin, dragStartMin, startPosMin
    local movedMin = false

    MainFrame.InputBegan:Connect(function(input)
        if minimized and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            draggingMin = true
            dragStartMin = input.Position
            startPosMin = MainFrame.Position
            movedMin = false
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    draggingMin = false
                    if not movedMin then
                        setMinimized(false)
                    end
                end
            end)
        end
    end)

    MainFrame.InputChanged:Connect(function(input)
        if minimized and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            dragInputMin = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if minimized and input == dragInputMin and draggingMin then
            local delta = input.Position - dragStartMin
            if delta.Magnitude > 4 then
                movedMin = true
            end
            MainFrame.Position = UDim2.new(startPosMin.X.Scale, startPosMin.X.Offset + delta.X, startPosMin.Y.Scale, startPosMin.Y.Offset + delta.Y)
        end
    end)

