            if char and char:FindFirstChild("HumanoidRootPart") then
                -- Mengembalikan pengaturan AutoRotate Humanoid ke normal jika ada
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.AutoRotate = true
                end
            end
        end)
    end)

