    -- Fly
    local flyConn, controlModule, lockedPosition
    pcall(function()
        controlModule = require(LocalPlayer.PlayerScripts:WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
    end)

    createToggle("Fly", function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if not root or not hum then return end
        
        lockedPosition = root.Position
        
        flyConn = RunService.RenderStepped:Connect(function()
            if not char or not char.Parent or not hum or hum.Health <= 0 then return end
            
            hum:ChangeState(Enum.HumanoidStateType.Physics)
            
            local camCFrame = Camera.CFrame
            local moveVector = Vector3.zero
            if controlModule then
                moveVector = controlModule:GetMoveVector()
            end
            
            local look = camCFrame.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            if flatLook.Magnitude > 0 then
                flatLook = flatLook.Unit
            else
                flatLook = Vector3.new(0, 0, -1)
            end
            
            if moveVector.Magnitude > 0 then
                local flySpeed = 50
                local direction = (camCFrame.LookVector * -moveVector.Z) + (camCFrame.RightVector * moveVector.X) + (camCFrame.UpVector * (moveVector.Y or 0))
                root.AssemblyLinearVelocity = direction * flySpeed
                lockedPosition = root.Position
                root.CFrame = CFrame.new(root.Position, root.Position + flatLook)
            else
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.CFrame = CFrame.new(lockedPosition, lockedPosition + flatLook)
            end
        end)
    end, function()
        if flyConn then flyConn:Disconnect() end
        lockedPosition = nil
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if hum then 
            hum:ChangeState(Enum.HumanoidStateType.GettingUp) 
        end
        if root then
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end)

