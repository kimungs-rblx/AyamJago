    -- FUNGSI TELEPORT & SAVE
    local RagdollEvent = ReplicatedStorage.Library.Modules.Ragdoll.Ragdoll
    local function teleportPlayer(targetPos)
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local root = char.HumanoidRootPart
        local hum = char:FindFirstChild("Humanoid")
        local safePos = Vector3.new(targetPos.X, targetPos.Y + 3, targetPos.Z)
        root.CFrame = CFrame.new(safePos)
        pcall(function() firesignal(RagdollEvent.OnClientEvent, "Make", 2.5, safePos) end)
        task.delay(0.5, function()
            pcall(function() firesignal(RagdollEvent.OnClientEvent, "Destroy", 2.5) end)
            if hum then hum.PlatformStanding = false; hum.Sit = false; hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
        end)
    end

    local savedPos = nil
    createButton("Save Cord", Color3.fromRGB(180, 40, 40), function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            savedPos = LocalPlayer.Character.HumanoidRootPart.Position
            notify("Location System", "Koordinat berhasil disimpan!")
        end
    end)

    createButton("TP Cord", Color3.fromRGB(15, 120, 30), function()
        if savedPos then teleportPlayer(savedPos); notify("Location System", "Berhasil TP!") else notify("Location System", "Belum ada koordinat!") end
    end)

    createButton("Fix Stuck", Color3.fromRGB(180, 100, 20), function()
        local char = LocalPlayer.Character
        if char then
            for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.Anchored = false end end
            if char:FindFirstChild("Humanoid") then char.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
            pcall(function() firesignal(RagdollEvent.OnClientEvent, "Destroy", 2.5) end)
            notify("System", "Karakter berhasil di-fix!")
        end
    end)

    -- Toggle Buttons Helper
    local function createToggle(name, onEnable, onDisable)
        local btn = createButton(name, Color3.fromRGB(40, 40, 40), function() end)
        btn.TextColor3 = Color3.fromRGB(200, 40, 40)
        local enabled = false
        btn.MouseButton1Click:Connect(function()
            enabled = not enabled
            if enabled then
                btn.TextColor3 = Color3.fromRGB(40, 200, 40)
                notify(name, name .. " Diaktifkan")
                onEnable()
            else
                btn.TextColor3 = Color3.fromRGB(200, 40, 40)
                notify(name, name .. " Dimatikan")
                onDisable()
            end
        end)
        return btn
    end

