    createButton("Tween Cord", Color3.fromRGB(15, 100, 150), function()
        pcall(function()
            if savedPos then
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                    local root = char.HumanoidRootPart
                    local humanoid = char.Humanoid
                    
                    local dist = (root.Position - savedPos).Magnitude
                    local baseSpeed = humanoid.WalkSpeed
                    if baseSpeed <= 0 then baseSpeed = 16 end
                    
                    local adjustedSpeed = baseSpeed * 1.25
                    local travelTime = dist / adjustedSpeed
                    travelTime = math.clamp(travelTime, 0.3, 20)
                    
                    local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Linear)
                    local targetCFrame = CFrame.new(savedPos + Vector3.new(0, 3, 0))
                    
                    TweenService:Create(root, tweenInfo, {CFrame = targetCFrame}):Play()
                    notify("TP System", "Sedang Tween Cord...")
                else
                    notify("TP System", "Karakter tidak valid!")
                end
            else
                notify("Location System", "Belum ada koordinat tersimpan!")
            end
        end)
    end)

