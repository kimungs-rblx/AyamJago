-- FUNGSI CUSTOM NOTIFIKASI
local function notify(title, text)
    pcall(function()
        local existing = PlayerGui:FindFirstChild("CustomNotifyGui")
        if existing then existing:Destroy() end
        local notifyGui = Instance.new("ScreenGui", PlayerGui); notifyGui.Name = "CustomNotifyGui"
        local frame = Instance.new("Frame", notifyGui); frame.Size = UDim2.new(0, 160, 0, 45); frame.Position = UDim2.new(0.5, -80, 0, 15); frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
        local t = Instance.new("TextLabel", frame); t.Size = UDim2.new(1,0,1,0); t.BackgroundTransparency = 1; t.Text = title..": "..text; t.TextColor3 = Color3.new(1,1,1); t.Font = Enum.Font.GothamBold; t.TextSize = 11
        task.delay(2, function() notifyGui:Destroy() end)
    end)
end

-- INISIALISASI UI
local ScreenGui = Instance.new("ScreenGui", PlayerGui); ScreenGui.Name = "RagdollMenu"
local MainFrame = Instance.new("Frame", ScreenGui); MainFrame.Size = UDim2.new(0, 128, 0, 190); MainFrame.Position = UDim2.new(0.1, 0, 0.1, 0); MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20); MainFrame.Active = true; MainFrame.Draggable = true
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)

-- LOGIKA MINIMIZE & DRAG (FIXED THRESHOLD 3 PIXEL)
local minimized = false
local startInputPos, startGuiPos, hasMoved = nil, nil, false

MainFrame.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        startInputPos = input.Position; startGuiPos = MainFrame.Position; hasMoved = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if startInputPos and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        if (input.Position - startInputPos).Magnitude > 3 then 
            hasMoved = true
            if minimized then
                MainFrame.Position = UDim2.new(startGuiPos.X.Scale, startGuiPos.X.Offset + (input.Position.X - startInputPos.X), startGuiPos.Y.Scale, startGuiPos.Y.Offset + (input.Position.Y - startInputPos.Y))
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if startInputPos and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        if not hasMoved then
            minimized = not minimized
            MainFrame.Size = minimized and UDim2.new(0, 34, 0, 34) or UDim2.new(0, 128, 0, 190)
            for _, c in pairs(MainFrame:GetChildren()) do if c:IsA("ScrollingFrame") or c:IsA("TextLabel") or c:IsA("TextButton") then c.Visible = not minimized end end
        end
        startInputPos = nil
    end
end)

